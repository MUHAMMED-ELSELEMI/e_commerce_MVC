@model ecommerce.Models.ViewModel.ShoppingCartVM
<form method="post">
    <div class="container my-5">
        <div class="card shadow-lg">
            <div class="card-header bg-dark text-light d-flex justify-content-between align-items-center">
                <div>
                    <i class="fa fa-shopping-cart"></i> &nbsp; Order Summary
                </div>
                <div>
                    <a asp-action="Index" class="btn btn-light btn-sm">Back to Cart</a>
                </div>
            </div>
            <div class="card-body">
                <div class="container rounded p-3">
                    <div class="row">
                        <!-- Shipping Details Section -->
                        <div class="col-12 col-lg-6 pb-4">
                            <div class="mb-4">
                                <h4 class="text-primary border-bottom pb-2">Shipping Details:</h4>
                            </div>
                            <div class="row mb-3">
                                <div class="col-3">
                                    <label for="name" class="form-label">Name</label>
                                </div>
                                <div class="col-9">
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fa fa-user"></i></span>
                                        <input asp-for="OrderHeader.Name" class="form-control" placeholder="Enter your name" aria-label="Name" id="name" />
                                    </div>
                                    <span asp-validation-for="OrderHeader.Name" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-3">
                                    <label for="phone" class="form-label">Phone</label>
                                </div>
                                <div class="col-9">
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fa fa-phone"></i></span>
                                        <input asp-for="OrderHeader.PhoneNumber" class="form-control" placeholder="Enter your phone number" aria-label="Phone" id="phone" />
                                    </div>
                                    <span asp-validation-for="OrderHeader.PhoneNumber" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-3">
                                    <label for="street" class="form-label">Street Address</label>
                                </div>
                                <div class="col-9">
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fa fa-map-marker-alt"></i></span>
                                        <input asp-for="OrderHeader.StreetAddress" class="form-control" placeholder="Enter your street address" aria-label="Street Address" id="street" />
                                    </div>
                                    <span asp-validation-for="OrderHeader.StreetAddress" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-3">
                                    <label for="city" class="form-label">City</label>
                                </div>
                                <div class="col-9">
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fa fa-city"></i></span>
                                        <input asp-for="OrderHeader.City" class="form-control" placeholder="Enter your city" aria-label="City" id="city" />
                                    </div>
                                    <span asp-validation-for="OrderHeader.City" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-3">
                                    <label for="state" class="form-label">State</label>
                                </div>
                                <div class="col-9">
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fa fa-flag"></i></span>
                                        <input asp-for="OrderHeader.State" class="form-control" placeholder="Enter your state" aria-label="State" id="state" />
                                    </div>
                                    <span asp-validation-for="OrderHeader.State" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-3">
                                    <label for="postal" class="form-label">Postal Code</label>
                                </div>
                                <div class="col-9">
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fa fa-envelope"></i></span>
                                        <input asp-for="OrderHeader.PostalCode" class="form-control" placeholder="Enter your postal code" aria-label="Postal Code" id="postal" />
                                    </div>
                                    <span asp-validation-for="OrderHeader.PostalCode" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <!-- Order Summary Section -->
                        <div class="col-12 col-lg-5 offset-lg-1">
                            <div class="mb-4">
                                <h4 class="text-primary border-bottom pb-2">Order Summary:</h4>
                            </div>
                            <ul class="list-group mb-3">
                                @foreach (var details in Model.ListCart)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="my-0">@details.Product.Title</h6>
                                            <small class="text-muted">Quantity: @details.Count</small>
                                        </div>
                                        <span class="text-muted">@((details.Price * details.Count).ToString("c"))</span>
                                    </li>
                                }
                                <li class="list-group-item d-flex justify-content-between align-items-center bg-light">
                                    <small class="text-primary">Total (USD)</small>
                                    <strong class="text-primary">@Model.OrderHeader.OrderTotal.ToString("c")</strong>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <div class="row align-items-center">
                    <div class="col-12 col-md-8">
                        <p style="color:maroon; font-size:14px;" class="mb-0">
                            Estimated Arrival Date: <strong>@DateTime.Now.AddDays(7).ToShortDateString()</strong> - <strong>@DateTime.Now.AddDays(14).ToShortDateString()</strong>
                        </p>
                    </div>
                    <div class="col-12 col-md-4">
                        <button type="submit" value="Place Order" class="btn btn-primary form-control">Place Order</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
