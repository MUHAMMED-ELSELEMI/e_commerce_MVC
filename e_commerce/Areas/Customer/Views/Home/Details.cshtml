@model ShoppingCart

<form method="post">
    <input hidden asp-for="ProductId" />
    <div class="container product-details">
        <div class="row mb-4">
            <div class="col-12 position-relative">
                <h1 class="text-center py-2 bg-primary text-white">@Model.Product.Title</h1>
            </div>
            <div class="row mb-4">
                <div>
                    <a asp-action="Index" class="btn btn-secondary btn-fancy position-absolute">Back to Home</a>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4 text-center">
                <img src="@Model.Product.ImageUrl" class="img-fluid rounded shadow product-image" alt="@Model.Product.Title" />
            </div>
            <div class="col-md-8">
                <div class="row">
                    <div class="col-12 mb-4">
                        <h2>Product Information</h2>
                        <table class="table table-bordered">
                            <tbody>
                                <tr>
                                    <th>Author</th>
                                    <td>@Html.DisplayFor(model => model.Product.Author)</td>
                                </tr>
                                <tr>
                                    <th>ISBN</th>
                                    <td>@Html.DisplayFor(model => model.Product.ISBN)</td>
                                </tr>
                                <tr>
                                    <th>Description</th>
                                    <td>@Html.Raw(Model.Product.Description)</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="col-12">
                        <h2>Pricing</h2>
                        <table class="table table-bordered">
                            <tbody>
                                <tr>
                                    <th>List Price</th>
                                    <td class="text-decoration-line-through">@Html.DisplayFor(model => model.Product.ListPrice)</td>
                                </tr>
                                <tr>
                                    <th>50+ units</th>
                                    <td>@Html.DisplayFor(model => model.Product.Price50)</td>
                                </tr>
                                <tr>
                                    <th>100+ units</th>
                                    <td>@Html.DisplayFor(model => model.Product.Price100)</td>
                                </tr>
                                <tr class="table-primary">
                                    <th>Current Price</th>
                                    <td><strong>@Html.DisplayFor(model => model.Product.Price)</strong></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="row mt-4">
                    <div class="col-12 d-flex btn-fancy align-items-center">
                        <div class="input-group" style="width: 200px; margin-right: 30px;">
                            <div class="input-group-prepend">
                                <span class="input-group-text bg-secondary text-white">count</span>
                            </div>
                            <input asp-for="Count" type="number" class="form-control" value="1" min="1">
                        </div>
                        <div>
                            <button type="submit" class="btn btn-primary ">Add to Cart</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
