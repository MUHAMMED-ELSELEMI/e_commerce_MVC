@model IEnumerable<ecommerce.Models.Companies>
@{
    ViewData["Title"] = "Companies";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="display-4">Companies</h3>
        <a asp-action="Upsert"  class="btn btn-primary">
            <i class="fas fa-plus-circle mr-2"></i> @(" ") Create New
        </a>
    </div>
    <div class="table-responsive">
        <table id="tblData" class="table table-hover table-bordered shadow-sm" style="width: 100%">
            <thead class="thead-dark">
                <tr>
                    <th> Name</th>
                    <th> Phone Number</th>
                    <th> Address</th>
                    <th> Postal Code</th>
                    <th></th>
                </tr>
            </thead>

        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/Company.js"></script>
}
