@model Companies

@{
    ViewData["Title"] = "Company Details";
}

<div class="container product-details mt-5">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h1 class="text-center mb-0">@Model.CompanyName</h1>
        </div>
        <div class="card-body">
            <div class="row mb-4">
                <div class="col-12">
                    <a asp-action="Index" class="btn btn-secondary btn-fancy">
                        <i class="fas fa-arrow-left me-2"></i>Back to List
                    </a>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-4">
                    <h2 class="h4 mb-3">Company Information</h2>
                    <table class="table table-bordered table-hover">
                        <tbody>
                            <tr>
                                <th class="bg-light">Company Name</th>
                                <td>@Html.DisplayFor(model => model.CompanyName)</td>
                            </tr>
                            <tr>
                                <th class="bg-light">Phone Number</th>
                                <td>@Html.DisplayFor(model => model.CompanyPhoneNumber)</td>
                            </tr>
                            <tr>
                                <th class="bg-light">Address</th>
                                <td>@Html.Raw(Model.CompanyAddress)</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="col-md-6 mb-4">
                    <h2 class="h4 mb-3">Location Details</h2>
                    <table class="table table-bordered table-hover">
                        <tbody>
                            <tr>
                                <th class="bg-light">Postal Code</th>
                                <td>@Html.DisplayFor(model => model.CompanyPostalCode)</td>
                            </tr>
                            <tr>
                                <th class="bg-light">State</th>
                                <td>@Html.DisplayFor(model => model.CompanyState)</td>
                            </tr>
                            <tr>
                                <th class="bg-light">City</th>
                                <td>@Html.DisplayFor(model => model.CompanyCity)</td>
                            </tr>
                            <tr>
                                <th class="bg-light">Street Address</th>
                                <td>@Html.DisplayFor(model => model.CompanyStreetAddress)</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="row mt-4">
                <div class="col-12">
                    <a asp-action="Upsert" asp-route-id="@Model.CompanyId" class="btn btn-warning btn-fancy">
                        <i class="fas fa-edit me-2"></i>Edit
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
