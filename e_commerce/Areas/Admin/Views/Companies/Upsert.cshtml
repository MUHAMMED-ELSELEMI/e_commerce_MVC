@model Companies
@{
    ViewData["Title"] = "Create Companies";
}

<div class="container mt-5">
    <h1 class="mb-4"> @(Model.CompanyId != 0 ? "Update" : "Create") Company </h1>
    <div class="card shadow border-0">
        <div class="card-body">
            <form asp-action="Upsert" enctype="multipart/form-data">
                <input asp-for="CompanyId" hidden />
                <div class="row">
                    <div class="col-10">
                        @*<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>*@
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <div class="form-floating">
                                    <input asp-for="CompanyName" class="form-control" placeholder="Title" />
                                    <label asp-for="CompanyName"></label>
                                    <span asp-validation-for="CompanyName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <div class="form-floating">
                                    <input asp-for="CompanyPostalCode" class="form-control" placeholder="ISBN" />
                                    <label asp-for="CompanyPostalCode"></label>
                                    <span asp-validation-for="CompanyPostalCode" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <div class="form-floating">
                                    <input asp-for="CompanyPhoneNumber" class="form-control" placeholder="Author" />
                                    <label asp-for="CompanyPhoneNumber"></label>
                                    <span asp-validation-for="CompanyPhoneNumber" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <div class="form-floating">
                                    <input asp-for="CompanyPostalCode" class="form-control" placeholder="ISBN" />
                                    <label asp-for="CompanyPostalCode"></label>
                                    <span asp-validation-for="CompanyPostalCode" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <div class="form-floating">
                                    <input asp-for="CompanyStreetAddress" class="form-control" placeholder="List Price" />
                                    <label asp-for="CompanyStreetAddress"></label>
                                    <span asp-validation-for="CompanyStreetAddress" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <div class="form-floating">
                                    <input asp-for="CompanyState" class="form-control" placeholder="Price" />
                                    <label asp-for="CompanyState"></label>
                                    <span asp-validation-for="CompanyState" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <div class="form-floating">
                                    <input asp-for="CompanyAddress" class="form-control" placeholder="List Price" />
                                    <label asp-for="CompanyAddress"></label>
                                    <span asp-validation-for="CompanyAddress" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <div class="form-floating">
                                    <input asp-for="CompanyCity" class="form-control" placeholder="Price" />
                                    <label asp-for="CompanyCity"></label>
                                    <span asp-validation-for="CompanyCity" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                            <div class="d-flex justify-content-between mt-4">
                                <a asp-action="Index" class="btn btn-secondary btn-fancy">Back to List</a>
                                <input type="submit" value=" @(Model.CompanyId!=0? "Update" : "Create")" class="btn btn-primary " />
                            </div>

                       
                    </div>
            </form>
        </div>
    </div>
</div>
