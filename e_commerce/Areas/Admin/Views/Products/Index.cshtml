@model IEnumerable<ecommerce.Models.Product>
@{
    ViewData["Title"] = "Products";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="display-4">Products</h3>
        <a asp-action="Upsert" class="btn btn-primary ">
            <i class="fas fa-plus-circle mr-2"></i> @(" ") Create New
        </a>
    </div>
    <div class="table-responsive">
        <table id="tblData" class="table table-hover table-bordered shadow-sm" style="width: 100%">
            <thead class="thead-dark">
                <tr>
                    <th>Author</th>
                    <th>ISBN</th>
                    <th>Title</th>
                    <th>Price</th>
                    <th>Category</th>
                </tr>
            </thead>

        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/product.js"></script>
}
