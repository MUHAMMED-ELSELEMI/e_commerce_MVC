@model IEnumerable<ecommerce.Models.Category>
@{
    ViewData["Title"] = "Categories";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="display-4">Categories</h3>
        <a asp-action="Create" class="btn btn-primary btn-fancy">
            <i class="fas fa-plus-circle mr-2"></i>Create New
        </a>
    </div>

    <div class="card shadow">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="thead-light">
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.Name)</th>
                            <th>@Html.DisplayNameFor(model => model.DisplayOrder)</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                                <td>@Html.DisplayFor(modelItem => item.DisplayOrder)</td>
                                <td class="text-center">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm btn-fancy">
                                        <i class="fas fa-edit"></i> edit
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm btn-fancy">
                                        <i class="fas fa-info-circle"></i> details
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm btn-fancy">
                                        <i class="fas fa-trash-alt"></i> delete
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f8f9fa;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .card {
        border: none;
        border-radius: 15px;
        overflow: hidden;
    }

    .btn-fancy {
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        transition: all 0.3s ease;
    }

        .btn-fancy:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

    .btn-sm.btn-fancy {
        padding: 0.25rem 0.5rem;
        font-size: 0.875rem;
        line-height: 1.5;
        border-radius: 0.2rem;
    }

    .btn-primary.btn-fancy {
        background-color: #007bff;
        border-color: #007bff;
    }

    .btn-warning.btn-fancy {
        background-color: #ffc107;
        border-color: #ffc107;
        color: #212529;
    }

    .btn-info.btn-fancy {
        background-color: #17a2b8;
        border-color: #17a2b8;
    }

    .btn-danger.btn-fancy {
        background-color: #dc3545;
        border-color: #dc3545;
    }

    .table {
        margin-bottom: 0;
    }

    .table-hover tbody tr:hover {
        background-color: rgba(0, 123, 255, 0.075);
    }

    .thead-light th {
        background-color: #f8f9fa;
        color: #495057;
        border-color: #dee2e6;
    }

    .shadow {
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
    }
</style>